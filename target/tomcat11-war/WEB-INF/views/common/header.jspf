<%@ page pageEncoding="UTF-8" %>
<!DOCTYPE html>
<html lang="vi">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title><c:out value="${pageTitle}"/> · Huy Books</title>
<meta name="theme-color" content="#193e34">
<link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css">
<script defer src="${pageContext.request.contextPath}/assets/js/app.js"></script></head>
<body>
<a class="skip-link" href="#main">Bỏ qua đến nội dung</a>
<div class="announcement">Một cuốn sách hay. Một thế giới mới. <span>Thanh toán khi nhận hàng · COD</span></div>
<header class="site-header"><div class="shell header-inner">
<a class="brand" href="${pageContext.request.contextPath}/home" aria-label="Huy Books — Trang chủ"><span class="brand-mark"><svg viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 8c-4-4-9-4-12-3v21c5-1 9 0 12 3 3-3 7-4 12-3V5c-3-1-8-1-12 3Zm0 0v21" stroke="currentColor" stroke-width="2"/></svg></span><span>huy<span class="brand-light">books</span><small>READ. GROW. INSPIRE.</small></span></a>
<button class="menu-toggle" type="button" aria-label="Mở menu" aria-expanded="false">☰</button>
<nav class="main-nav" aria-label="Điều hướng chính">
<a class="${activeNav == 'home' ? 'active' : ''}" href="${pageContext.request.contextPath}/home">Khám phá sách</a>
<c:if test="${not empty sessionScope.account}"><a class="${activeNav == 'orders' ? 'active' : ''}" href="${pageContext.request.contextPath}/orders">Đơn hàng của tôi</a></c:if>
<c:if test="${sessionScope.account.admin}"><a class="${activeNav == 'admin' ? 'active' : ''}" href="${pageContext.request.contextPath}/admin/dashboard">Quản trị</a></c:if>
</nav><div class="header-actions">
<a class="cart-link" href="${pageContext.request.contextPath}/cart" aria-label="Giỏ hàng"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Zm3 0V6a4 4 0 0 1 8 0v2" stroke="currentColor" stroke-width="1.6"/></svg><span class="cart-count">${empty cartCount ? 0 : cartCount}</span></a>
<c:choose><c:when test="${not empty sessionScope.account}"><details class="account-menu"><summary><span class="avatar">H</span><span class="account-name"><c:out value="${sessionScope.account.fullname}"/></span></summary><div class="account-popover"><small>ĐÃ ĐĂNG NHẬP</small><strong><c:out value="${sessionScope.account.fullname}"/></strong><a href="${pageContext.request.contextPath}/orders">Lịch sử đơn hàng</a><a href="${pageContext.request.contextPath}/logout">Đăng xuất</a></div></details></c:when><c:otherwise><a class="button button-small button-outline" href="${pageContext.request.contextPath}/login">Đăng nhập</a></c:otherwise></c:choose>
</div></div></header>
<c:if test="${not empty flash}"><div class="shell"><div class="notice" role="status"><c:out value="${flash}"/></div></div></c:if>
