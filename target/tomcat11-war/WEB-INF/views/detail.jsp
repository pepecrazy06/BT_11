<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="vi_VN"/>
<c:set var="pageTitle" value="Chi tiết sách"/><c:set var="activeNav" value="home"/>
<%@ include file="common/header.jspf" %>

<main id="main" class="shell page-main"><nav class="breadcrumbs"><a href="${pageContext.request.contextPath}/home">Tủ sách</a><span>/</span><span><c:out value="${book.title}"/></span></nav>
<div class="detail-layout"><div class="detail-cover"><img data-cover data-placeholder="${pageContext.request.contextPath}/assets/images/book-placeholder.svg" src="${pageContext.request.contextPath}/<c:out value='${book.cover_image}'/>" alt="<c:out value='${book.title}'/>"></div><section class="detail-info"><p class="eyebrow">MỘT CUỐN SÁCH, MỘT HÀNH TRÌNH</p><h1><c:out value="${book.title}"/></h1><p class="author-line">Tác giả: <c:forEach items="${book.authors}" var="a" varStatus="loop"><c:out value="${a.author_name}"/>${loop.last ? '' : ', '}</c:forEach><c:if test="${empty book.authors}">Đang cập nhật</c:if></p><a class="rating-line" href="#reviews">★ ${fn:length(book.ratings)} đánh giá từ bạn đọc</a><div class="detail-price"><fmt:formatNumber value="${book.price}" maxFractionDigits="0"/> đ</div>
<div class="detail-facts"><div><span>NHÀ XUẤT BẢN</span><c:out value="${book.publisher}"/></div><div><span>ISBN</span><c:out value="${book.isbn}"/></div><div><span>NGÀY XUẤT BẢN</span><fmt:formatDate value="${book.publish_date}" pattern="dd/MM/yyyy"/></div><div><span>TÌNH TRẠNG</span>${book.quantity > 0 ? 'Còn hàng' : 'Hết hàng'} · ${book.quantity} cuốn</div></div>
<c:choose><c:when test="${book.quantity > 0 and book.price != null and book.price >= 0}"><form method="post" action="${pageContext.request.contextPath}/cart"><input type="hidden" name="token" value="${cartToken}"><input type="hidden" name="action" value="add"><input type="hidden" name="bookid" value="${book.bookid}"><label class="small muted" for="buyQuantity">Số lượng · tối đa ${book.quantity > 99 ? 99 : book.quantity} cuốn</label><div class="purchase-row"><div class="quantity-control"><button type="button" data-quantity="-1" aria-label="Giảm số lượng">−</button><input id="buyQuantity" type="number" name="quantity" min="1" max="${book.quantity > 99 ? 99 : book.quantity}" value="1" required><button type="button" data-quantity="1" aria-label="Tăng số lượng">+</button></div><button>Thêm vào giỏ hàng ↗</button></div></form></c:when><c:otherwise><p class="notice">Cuốn sách này hiện chưa thể đặt mua.</p></c:otherwise></c:choose><p class="small muted" style="margin-top:18px">✓ Thanh toán khi nhận sách · ✓ Kiểm tra tồn kho khi đặt hàng</p></section></div>
<section class="description"><p class="eyebrow">VỀ CUỐN SÁCH</p><h2>Đôi dòng giới thiệu</h2><p><c:choose><c:when test="${not empty book.description}"><c:out value="${book.description}"/></c:when><c:otherwise>Một cuốn sách trong tủ sách Huy Books. Thông tin giới thiệu đang được cập nhật.</c:otherwise></c:choose></p></section>
<section id="reviews" class="review-layout"><div><h2>Góc bạn đọc <span class="muted">(${fn:length(book.ratings)})</span></h2><c:if test="${empty book.ratings}"><p class="muted small">Chưa có đánh giá. Hãy là người đầu tiên chia sẻ cảm nhận!</p></c:if><c:forEach items="${book.ratings}" var="r"><article class="review-item"><strong><c:out value="${r.user.fullname}"/></strong><span class="stars">★ ${empty r.rating ? 5 : r.rating}/5</span><p><c:out value="${r.review_text}"/></p></article></c:forEach></div><div class="panel"><h2 style="font-size:25px">Chia sẻ cảm nhận</h2><c:choose><c:when test="${not empty sessionScope.account}"><form class="form" method="post" action="${pageContext.request.contextPath}/review"><input type="hidden" name="token" value="${cartToken}"><input type="hidden" name="bookid" value="${book.bookid}"><label for="stars">Đánh giá của bạn</label><select id="stars" name="rating"><option value="5">★★★★★ — Rất yêu thích</option><option value="4">★★★★ — Hay</option><option value="3">★★★ — Bình thường</option><option value="2">★★ — Chưa hài lòng</option><option value="1">★ — Không phù hợp</option></select><label for="reviewText">Cảm nhận về cuốn sách</label><textarea id="reviewText" name="review_text" maxlength="1000" placeholder="Điều gì ở cuốn sách khiến bạn ấn tượng?" required></textarea><button class="button-full">Gửi đánh giá</button></form></c:when><c:otherwise><p class="small muted">Đăng nhập để chia sẻ cảm nhận của bạn với cộng đồng.</p><a class="button button-outline" href="${pageContext.request.contextPath}/login">Đăng nhập</a></c:otherwise></c:choose></div></section></main>
<%@ include file="common/footer.jspf" %>