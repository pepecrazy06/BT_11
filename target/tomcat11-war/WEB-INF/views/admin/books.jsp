<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="vi_VN"/>
<c:set var="pageTitle" value="Quản lý sách"/><c:set var="activeNav" value="admin"/>
<%@ include file="../common/header.jspf" %>
<main id="main" class="shell page-main"><c:set var="adminTab" value="books"/><%@ include file="../common/admin-nav.jspf" %><div class="page-heading"><div><p class="eyebrow">CHĂM CHÚT TỪNG CUỐN SÁCH</p><h1>Quản lý sách</h1><p>${total} đầu sách trong tủ sách.</p></div><a class="button button-small" href="${pageContext.request.contextPath}/admin/books?action=add">+ Thêm sách mới</a></div><div class="table-scroll"><table><thead><tr><th>Cuốn sách</th><th>Giá bán</th><th>Tồn kho</th><th>Nhà xuất bản</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${books}" var="b"><tr><td><div class="table-product"><img data-cover data-placeholder="${pageContext.request.contextPath}/assets/images/book-placeholder.svg" src="${pageContext.request.contextPath}/<c:out value='${b.cover_image}'/>" alt=""><div><strong><c:out value="${b.title}"/></strong><small>ISBN: <c:out value="${b.isbn}"/></small></div></div></td><td><strong><fmt:formatNumber value="${b.price}" maxFractionDigits="0"/> đ</strong></td><td><span class="status ${b.quantity <= 5 ? 'PENDING' : 'CONFIRMED'}">${b.quantity} cuốn</span></td><td><c:out value="${b.publisher}"/></td><td><div class="table-actions"><a class="button button-small button-outline" href="${pageContext.request.contextPath}/admin/books?action=edit&id=${b.bookid}">Sửa</a><form method="post" action="${pageContext.request.contextPath}/admin/books" data-confirm="Xóa cuốn sách này? Thao tác có thể bị từ chối nếu còn đánh giá liên quan."><input type="hidden" name="token" value="${cartToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${b.bookid}"><button class="button-danger">Xóa</button></form></div></td></tr></c:forEach><c:if test="${empty books}"><tr><td colspan="5" style="text-align:center;padding:40px">Chưa có sách. Hãy thêm cuốn sách đầu tiên.</td></tr></c:if></tbody></table></div><c:set var="paginationPath" value="/admin/books"/><%@ include file="../common/pagination.jspf" %></main>
<%@ include file="../common/footer.jspf" %>