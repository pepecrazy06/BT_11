<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="vi_VN"/>
<c:set var="pageTitle" value="Thông tin sách"/><c:set var="activeNav" value="admin"/>
<%@ include file="../common/header.jspf" %>
<main id="main" class="shell page-main"><c:set var="adminTab" value="books"/><%@ include file="../common/admin-nav.jspf" %><div class="form-page"><div class="page-heading"><div><p class="eyebrow">CHĂM CHÚT TỪNG CHI TIẾT</p><h1>${empty book and empty param.bookid ? 'Thêm sách mới' : 'Chỉnh sửa sách'}</h1><p>Thông tin đầy đủ giúp bạn đọc tìm đúng cuốn sách.</p></div></div><c:if test="${not empty error}"><div class="error" role="alert"><c:out value="${error}"/></div></c:if><form class="form panel" method="post" action="${pageContext.request.contextPath}/admin/books"><input type="hidden" name="token" value="${cartToken}"><input type="hidden" name="bookid" value="${not empty form ? fn:escapeXml(param.bookid) : book.bookid}"><div class="form-grid"><div class="full-span"><label for="title">Tên sách *</label><input id="title" name="title" maxlength="200" required value="<c:out value='${not empty form ? param.title : book.title}'/>" placeholder="Nhập tên cuốn sách"></div><div><label for="isbn">ISBN *</label><input id="isbn" name="isbn" maxlength="255" required value="<c:out value='${not empty form ? param.isbn : book.isbn}'/>"></div><div><label for="publisher">Nhà xuất bản *</label><input id="publisher" name="publisher" maxlength="255" required value="<c:out value='${not empty form ? param.publisher : book.publisher}'/>"></div><div><label for="price">Giá bán (đ) *</label><input id="price" type="number" min="0" step="0.01" name="price" required value="<c:out value='${not empty form ? param.price : book.price}'/>"></div><div><label for="quantity">Số lượng tồn kho *</label><input id="quantity" type="number" min="0" max="2147483647" step="1" name="quantity" required value="<c:out value='${not empty form ? param.quantity : book.quantity}'/>"></div><div><label for="publish_date">Ngày xuất bản</label><fmt:formatDate value="${book.publish_date}" pattern="yyyy-MM-dd" var="published"/><input id="publish_date" type="date" name="publish_date" value="<c:out value='${not empty form ? param.publish_date : published}'/>"></div><div><label for="cover_image">Đường dẫn ảnh bìa</label><input id="cover_image" name="cover_image" maxlength="255" value="<c:out value='${not empty form ? param.cover_image : book.cover_image}'/>" placeholder="assets/images/nha-gia-kim.jpg"><small>Ảnh có sẵn trong assets/images/. Để trống dùng bìa mặc định.</small></div><div class="full-span"><label>Tác giả</label><div class="check-list"><c:forEach items="${authors}" var="a"><label><input type="checkbox" name="authors" value="${a.author_id}" ${selectedAuthors.contains(a.author_id) ? 'checked' : ''}><c:out value="${a.author_name}"/></label></c:forEach><c:if test="${empty authors}"><span class="small muted">Hãy thêm tác giả trước ở mục Tác giả.</span></c:if></div></div><div class="full-span"><label for="description">Giới thiệu sách</label><textarea id="description" name="description" maxlength="2000" placeholder="Điều gì làm cuốn sách này đặc biệt?"><c:out value="${not empty form ? param.description : book.description}"/></textarea></div></div><div class="form-actions"><button>Lưu thông tin sách</button><a class="button button-outline" href="${pageContext.request.contextPath}/admin/books">Quay lại</a></div></form></div></main>
<%@ include file="../common/footer.jspf" %>