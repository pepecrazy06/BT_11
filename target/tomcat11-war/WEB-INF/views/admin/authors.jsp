<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="vi_VN"/>
<c:set var="pageTitle" value="Quản lý tác giả"/><c:set var="activeNav" value="admin"/>
<%@ include file="../common/header.jspf" %>
<main id="main" class="shell page-main"><c:set var="adminTab" value="authors"/><%@ include file="../common/admin-nav.jspf" %><div class="page-heading"><div><p class="eyebrow">NHỮNG NGƯỜI KỂ CHUYỆN</p><h1>Quản lý tác giả</h1><p>${total} tác giả trong danh sách.</p></div><a class="button button-small" href="${pageContext.request.contextPath}/admin/authors?action=add">+ Thêm tác giả</a></div><div class="table-scroll"><table><thead><tr><th>Mã tác giả</th><th>Tên tác giả</th><th>Ngày sinh</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${authors}" var="a"><tr><td>#${a.author_id}</td><td><div class="table-product"><span class="author-avatar"><c:out value="${fn:substring(a.author_name,0,1)}"/></span><strong><c:out value="${a.author_name}"/></strong></div></td><td><fmt:formatDate value="${a.date_of_birth}" pattern="dd/MM/yyyy"/></td><td><div class="table-actions"><a class="button button-small button-outline" href="${pageContext.request.contextPath}/admin/authors?action=edit&id=${a.author_id}">Sửa</a><form method="post" action="${pageContext.request.contextPath}/admin/authors" data-confirm="Xóa tác giả này? Tác giả đang liên kết với sách không thể xóa."><input type="hidden" name="token" value="${cartToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${a.author_id}"><button class="button-danger">Xóa</button></form></div></td></tr></c:forEach><c:if test="${empty authors}"><tr><td colspan="4" style="text-align:center;padding:40px">Chưa có tác giả.</td></tr></c:if></tbody></table></div><c:set var="paginationPath" value="/admin/authors"/><%@ include file="../common/pagination.jspf" %></main>
<%@ include file="../common/footer.jspf" %>