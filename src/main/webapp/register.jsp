<%@ page contentType="text/html;charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<fmt:setLocale value="vi_VN"/>
<c:set var="pageTitle" value="Đăng ký"/><c:set var="activeNav" value=""/>
<%@ include file="/WEB-INF/views/common/header.jspf" %>
<main id="main" class="shell"><div class="auth-layout"><aside class="auth-story"><div><p class="eyebrow">HUY BOOKS · GÓC NHỎ CHO BẠN ĐỌC</p><h2>Hành trình mới<br>bắt đầu từ<br>một trang sách.</h2><blockquote>“Sách là phép màu độc đáo<br>mà bạn có thể mang theo.”</blockquote></div><small>Thái Nhựt Huy · MSSV 24110227</small></aside><section class="auth-form"><p class="eyebrow">GIA NHẬP CỘNG ĐỒNG BẠN ĐỌC</p><h1>Tạo tài khoản</h1><p class="form-subtitle">Lưu đơn hàng và chia sẻ những cuốn sách bạn yêu thích.</p><c:if test="${not empty error}"><div class="error" role="alert"><c:out value="${error}"/></div></c:if><form class="form" method="post" action="${pageContext.request.contextPath}/register"><input type="hidden" name="token" value="${cartToken}"><label for="fullname">Họ và tên</label><input id="fullname" name="fullname" maxlength="100" required autocomplete="name" placeholder="Họ tên của bạn" value="<c:out value='${param.fullname}'/>"><div class="form-grid"><div><label for="email">Email</label><input id="email" name="email" type="email" maxlength="200" required autocomplete="email" placeholder="ban@example.com" value="<c:out value='${param.email}'/>"></div><div><label for="phone">Số điện thoại</label><input id="phone" name="phone" type="tel" maxlength="20" required autocomplete="tel" placeholder="0901234567" value="<c:out value='${param.phone}'/>"></div></div><label for="password">Mật khẩu</label><div class="password-field"><input id="password" name="password" type="password" minlength="8" maxlength="100" required autocomplete="new-password" placeholder="Ít nhất 8 ký tự"><button class="password-toggle" type="button" data-password aria-pressed="false">Hiện</button></div><label for="confirmPassword">Nhập lại mật khẩu</label><input id="confirmPassword" name="confirmPassword" type="password" minlength="8" maxlength="100" required autocomplete="new-password" placeholder="Nhập lại mật khẩu"><button class="button-full">Đăng ký & gửi mã xác thực →</button></form><p class="auth-switch">Đã có tài khoản? <a class="text-link" href="${pageContext.request.contextPath}/login">Đăng nhập</a></p></section></div></main>
<%@ include file="/WEB-INF/views/common/footer.jspf" %>