<%@ page pageEncoding="UTF-8" %>
<c:if test="${totalPage > 1}"><nav class="pagination" aria-label="Phân trang"><c:forEach begin="${currentPage > 2 ? currentPage-2 : 1}" end="${currentPage+2 < totalPage ? currentPage+2 : totalPage}" var="i"><c:url value="${paginationPath}" var="pageUrl"><c:param name="page" value="${i}"/><c:if test="${paginationPath == '/home'}"><c:param name="q" value="${q}"/><c:param name="sort" value="${sort}"/><c:param name="available" value="${available ? '1' : '0'}"/></c:if><c:if test="${not empty param.status}"><c:param name="status" value="${param.status}"/></c:if></c:url><a class="${currentPage == i ? 'current' : ''}" href="${pageUrl}" aria-label="Trang ${i}">${i}</a></c:forEach><span class="muted">Trang ${currentPage}/${totalPage}</span></nav></c:if>